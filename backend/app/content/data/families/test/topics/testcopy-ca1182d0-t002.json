    {
      "title": "on, in ali at?",
      "text": "ON + dan ali datum (on Monday, on the 5th of May). IN + mesec, letni čas, del dneva (in June, in winter, in the morning, in the evening). AT + night (at night).",
      "example": "I play football on Saturday. My birthday is in June. I sleep at night."
    },
    {
      "title": "Vrstilni števniki",
      "text": "1st first, 2nd second, 3rd third, potem večinoma + th: 4th fourth, 15th fifteenth. Pazi: 5th fifth, 8th eighth, 9th ninth, 12th twelfth, 20th twentieth, 21st twenty-first.",
